{
  "name": "hackernews-backend",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "watch": "nodemon ./bin/www",
    "worker": "node worker.js",
    "worker-nodemon": "nodemon worker.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --forceExit --detectOpenHandles --passWithNoTests",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "import": "node scripts/import-json-to-sqlite.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "migrate:status": "node scripts/migrate.js status",
    "users": "node scripts/users.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "~4.4.3",
    "dotenv": "^18.0.9",
    "express": "~5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "morgan": "~1.12.1"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "hackernews-frontend/**/*.{js,jsx}": "eslint --config hackernews-frontend/eslint.config.js --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "@parcel/watcher": true,
    "fsevents": true,
    "unrs-resolver": true
  }
}
