{
  "name": "hackernews-backend",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "watch": "nodemon ./bin/www",
    "worker": "node worker.js",
    "worker-nodemon": "nodemon worker.js",
    "test": "jest --forceExit --detectOpenHandles --passWithNoTests",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "import": "node scripts/import-json-to-sqlite.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "migrate:status": "node scripts/migrate.js status",
    "users": "node scripts/users.js"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "better-sqlite3": "^13.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "~4.4.3",
    "dotenv": "^17.4.2",
    "express": "~5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "morgan": "~1.12.1"
  },
  "lint-staged": {
    "*.js": "eslint --fix",
    "hackernews-frontend/**/*.{js,jsx}": "eslint --config hackernews-frontend/eslint.config.js --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
