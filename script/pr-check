#!/usr/bin/env python3
"""Checks a pull request's description and diff. Python 3 standard library only.

1. The body has every `## ` heading of .github/pull_request_template.md, each with content
   (HTML comments, the template's prompts, do not count). Dependabot's pull requests are exempt.
2. A pull request whose title starts with `fix` changes at least one test file (the `tests`
   globs of script/process-check.conf).

In CI it reads the pull_request event ($GITHUB_EVENT_PATH) and needs the base and head commits
in the clone (actions/checkout with fetch-depth: 0). By hand:
    script/pr-check --title "fix: ..." --body-file body.md --base origin/main --head HEAD
"""
import argparse
import json
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
EXEMPT_AUTHORS = {"dependabot[bot]"}


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def test_globs():
    globs = "**/*_test.* **/test_*.py **/tests/**"
    path = os.path.join(HERE, "process-check.conf")
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for line in f:
                key, _, value = line.partition("=")
                if key.strip() == "tests" and value.strip():
                    globs = value.strip()
    return globs


def glob_regex(pattern):
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
        elif pattern.startswith("**", i):
            out, i = out + ".*", i + 2
        elif pattern[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif pattern[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(pattern[i]), i + 1
    return re.compile(out + r"\Z")


def sections(markdown):
    """Maps each `## ` heading to its text with HTML comments removed."""
    markdown = re.sub(r"<!--.*?-->", "", markdown, flags=re.S)
    found, current = {}, None
    for line in markdown.splitlines():
        m = re.match(r"^##\s+(.+?)\s*#*\s*$", line)
        if m:
            current = m.group(1)
            found.setdefault(current, "")
        elif re.match(r"^#\s", line):
            current = None
        elif current is not None:
            found[current] += line + "\n"
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--title")
    parser.add_argument("--body-file")
    parser.add_argument("--author", default="")
    parser.add_argument("--base")
    parser.add_argument("--head")
    args = parser.parse_args()

    if args.title is None:
        with open(os.environ["GITHUB_EVENT_PATH"], encoding="utf-8") as f:
            pr = json.load(f)["pull_request"]
        title, body = pr["title"], pr.get("body") or ""
        author, base, head = pr["user"]["login"], pr["base"]["sha"], pr["head"]["sha"]
    else:
        title, author, base, head = args.title, args.author, args.base, args.head
        body = open(args.body_file, encoding="utf-8").read() if args.body_file else ""

    root = git("rev-parse", "--show-toplevel").strip()
    problems = []

    if author in EXEMPT_AUTHORS:
        print(f"description check skipped: {author} writes its own description")
    else:
        template = os.path.join(root, ".github", "pull_request_template.md")
        with open(template, encoding="utf-8") as f:
            wanted = [h for h in sections(f.read())]
        have = sections(body)
        for heading in wanted:
            if heading not in have:
                problems.append(f"description lacks the section '## {heading}'")
            elif not have[heading].strip():
                problems.append(f"description section '## {heading}' is empty")

    if re.match(r"fix\b", title, re.I):
        changed = git("diff", "--name-only", f"{base}...{head}").split()
        regexes = [glob_regex(g) for g in test_globs().split()]
        tests = [f for f in changed if any(r.match(f) for r in regexes)]
        if not tests:
            problems.append("a fix changes no test file: add the regression test that failed "
                            "before the fix")
        else:
            print(f"fix touches tests: {', '.join(tests)}")

    for p in problems:
        print(f"::error::{p}" if os.environ.get("GITHUB_ACTIONS") else p)
    print(f"pr-check {'FAILED' if problems else 'ok'}: {len(problems)} problems")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
