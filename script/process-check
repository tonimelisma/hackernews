#!/usr/bin/env python3
"""Checks that requirements, tests and docs agree. Python 3 standard library only.

1. Every `Validates: <ID>` tag in a validating file (tests, by default) names a requirement
   declared exactly once in the requirement files, and no requirement is declared twice.
2. Every requirement is `[verified]` with at least one Validates tag, or `unverified: <reason>`
   with none.
3. Every relative link and every cited repository path in the checked docs resolves.

Settings come from script/process-check.conf next to this script (see that file). Run from
anywhere inside the repository; exits 1 and lists every problem as file:line when a check fails.
"""
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULTS = {
    "id_regex": r"[A-Z][A-Z0-9]*-[0-9]{3}",
    "requirements": "docs/requirements*.md",
    "tests": "**/*_test.* **/test_*.py **/tests/**",
    "validates": "",  # empty: the same files as tests
    "docs": "CLAUDE.md docs/**/*.md",
    "cited_exts": "md go py sh swift ts tsx js rs yml yaml",
    "ignore_paths": "NNNN",
}


def load_conf():
    conf = dict(DEFAULTS)
    path = os.path.join(HERE, "process-check.conf")
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            for n, line in enumerate(f, 1):
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" not in line:
                    sys.exit(f"{path}:{n}: expected key = value")
                key, value = (part.strip() for part in line.split("=", 1))
                if key not in DEFAULTS:
                    sys.exit(f"{path}:{n}: unknown key {key!r}")
                conf[key] = value
    if not conf["validates"]:
        conf["validates"] = conf["tests"]
    return conf


def glob_regex(pattern):
    """A glob as a regex over repository-relative paths: * and ? stay inside one path segment,
    ** crosses segments, and a leading **/ also matches files at the root."""
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
        elif pattern.startswith("**", i):
            out, i = out + ".*", i + 2
        elif pattern[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif pattern[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(pattern[i]), i + 1
    return re.compile(out + r"\Z")


def matching(files, globs):
    regexes = [glob_regex(g) for g in globs.split()]
    return sorted(f for f in files if any(r.match(f) for r in regexes))


def repo_files(root):
    out = subprocess.run(
        ["git", "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
        cwd=root, capture_output=True, check=True,
    ).stdout.decode()
    return sorted({f for f in out.split("\0") if f and os.path.lexists(os.path.join(root, f))})


def read_lines(root, rel):
    try:
        with open(os.path.join(root, rel), encoding="utf-8") as f:
            return f.read().splitlines()
    except (UnicodeDecodeError, IsADirectoryError):
        return []


def check_requirements(root, files, conf, problems):
    id_re = conf["id_regex"]
    decl_re = re.compile(r"^\s*[-*]\s+\*\*(" + id_re + r")\*\*")
    block_end = re.compile(r"^\s*$|^#|^\s*[-*]\s+\*\*")
    declared = {}  # id -> list of (file, line, block text)
    for rel in matching(files, conf["requirements"]):
        lines = read_lines(root, rel)
        for n, line in enumerate(lines):
            m = decl_re.match(line)
            if not m:
                continue
            block = [line]
            for follow in lines[n + 1:]:
                if block_end.match(follow):
                    break
                block.append(follow)
            declared.setdefault(m.group(1), []).append((rel, n + 1, " ".join(block)))

    validated = {}  # id -> list of file:line
    tag_re = re.compile(r"Validates:\s*(.*)")
    for rel in matching(files, conf["validates"]):
        for n, line in enumerate(read_lines(root, rel), 1):
            m = tag_re.search(line)
            if not m:
                continue
            ids = re.findall(id_re, m.group(1))
            if not ids:
                problems.append(f"{rel}:{n}: Validates: names no ID matching {id_re}")
            for rid in ids:
                validated.setdefault(rid, []).append(f"{rel}:{n}")
                if rid not in declared:
                    problems.append(f"{rel}:{n}: Validates: {rid} is not declared in any requirements file")

    for rid, places in sorted(declared.items()):
        rel, n, text = places[0]
        if len(places) > 1:
            others = ", ".join(f"{r}:{l}" for r, l, _ in places[1:])
            problems.append(f"{rel}:{n}: {rid} is declared more than once (also {others})")
        verified = "[verified]" in text
        reason = re.search(r"unverified:\s*(\S.*)", text)
        tags = validated.get(rid, [])
        if verified and reason:
            problems.append(f"{rel}:{n}: {rid} is marked both [verified] and unverified:")
        elif verified and not tags:
            problems.append(f"{rel}:{n}: {rid} is [verified] but no test says Validates: {rid}")
        elif reason and tags:
            problems.append(f"{rel}:{n}: {rid} is unverified: but tagged by {tags[0]}; mark it [verified]")
        elif not verified and not reason:
            problems.append(f"{rel}:{n}: {rid} needs [verified] or unverified: <reason>")
    return len(declared), sum(len(v) for v in validated.values())


LINK_RE = re.compile(r"!?\[[^\]]*\]\(\s*<?([^)\s>]+)>?(?:\s+\"[^\"]*\")?\s*\)")
CODE_RE = re.compile(r"(`+)(.+?)\1")


def check_docs(root, files, conf, problems):
    existing = set(files)
    for f in files:
        parts = f.split("/")
        for i in range(1, len(parts)):
            existing.add("/".join(parts[:i]))
    top = {f.split("/")[0] for f in existing}
    basenames = {os.path.basename(f) for f in files}
    exts = set(conf["cited_exts"].split())
    ignore = [re.compile(p) for p in conf["ignore_paths"].split()]
    checked = 0

    def resolves(doc_dir, target):
        target = target.rstrip("/")
        candidates = [os.path.normpath(os.path.join(doc_dir, target)), os.path.normpath(target)]
        return any(c in existing or c == "." for c in candidates)

    for rel in matching(files, conf["docs"]):
        doc_dir = os.path.dirname(rel)
        fenced = False
        for n, line in enumerate(read_lines(root, rel), 1):
            if re.match(r"^\s*(```|~~~)", line):
                fenced = not fenced
                continue
            if fenced:
                continue
            for _, code in CODE_RE.findall(line):
                cited = code.strip()
                cited = re.sub(r"(:\d+(-\d+)?|#.*)$", "", cited)
                if (not cited or re.search(r"[\s<>*?{}$~@|=\[\]()\\'\"]|://|^[-/]", cited)
                        or any(r.search(cited) for r in ignore)):
                    continue
                if "/" in cited.rstrip("/"):
                    first = re.sub(r"^(\./)+", "", cited).split("/")[0]
                    if first not in top and first != "..":
                        continue
                    ok = resolves(doc_dir, cited)
                else:
                    if cited.rsplit(".", 1)[-1] not in exts or "." not in cited:
                        continue
                    ok = cited in basenames or resolves(doc_dir, cited)
                checked += 1
                if not ok:
                    problems.append(f"{rel}:{n}: cited path `{code}` does not exist")
            for target in LINK_RE.findall(CODE_RE.sub("", line)):
                if re.match(r"^([a-z][a-z0-9+.-]*:|#)", target, re.I):
                    continue
                path = re.sub(r"%20", " ", target.split("#", 1)[0])
                checked += 1
                if not resolves(doc_dir, path):
                    problems.append(f"{rel}:{n}: link target {target} does not exist")
    return checked


def main():
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True,
                          text=True, check=True, cwd=HERE).stdout.strip()
    conf = load_conf()
    files = repo_files(root)
    problems = []
    reqs, tags = check_requirements(root, files, conf, problems)
    refs = check_docs(root, files, conf, problems)
    for p in problems:
        print(p)
    status = "FAILED" if problems else "ok"
    print(f"process-check {status}: {reqs} requirements, {tags} Validates tags, "
          f"{refs} doc references, {len(problems)} problems")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
